# ── 依赖 ──────────────────────────────────────────────
node_modules/

# ── 本机配置（含表格坐标、本机代理）────────────────────
# 云端用的是 config.ci.json（不含任何凭证），本文件不入库
config.json

# ── 运行时产物 ────────────────────────────────────────
# 审计快照、各种锁 / PID / 心跳 / 日志都不入库；
# 但 data/cache/ 是「历史视频池」——GitHub Actions 每轮全新环境，
# 缓存进仓库 + 跑完回写，云端才能补到窗口外的老行。
data/*
!data/cache/

# ── WorkBuddy 会话数据 ────────────────────────────────
.workbuddy/

# ── 其它 ──────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db