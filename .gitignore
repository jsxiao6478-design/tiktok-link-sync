# ── 依赖 ──────────────────────────────────────────────
node_modules/

# ── 本机配置（含表格坐标、本机代理）────────────────────
# 云端用的是 config.ci.json（不含任何凭证），本文件不入库
config.json

# ── 运行时产物 ────────────────────────────────────────
# 抓取缓存、审计快照、各种锁 / PID / 心跳 / 日志都在这里，不入库
data/

# ── WorkBuddy 会话数据 ────────────────────────────────
.workbuddy/

# ── 其它 ──────────────────────────────────────────────
*.log
.DS_Store
Thumbs.db
